# Копия этого файла -> .env (в репозиторий .env не попадает)
POSTGRES_USER=pfo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pfo
DATABASE_URL=postgresql+psycopg://pfo:change-me@db:5432/pfo

# Токен бота из BotFather
BOT_TOKEN=
# Публичный HTTPS-адрес Mini App (Telegram требует HTTPS)
WEBAPP_URL=https://example.com

# Ключ Anthropic API для ИИ-корректировки (этап 6); без него /adjust отвечает 503
ANTHROPIC_API_KEY=
# Модель (по умолчанию claude-opus-5-5)
LLM_MODEL=claude-opus-5-5

# Ключ подписи токенов API: openssl rand -hex 32
APP_SECRET=
# Разрешённые источники CORS (через запятую)
CORS_ORIGINS=http://localhost:5173

# Ключ внутренних запросов бота к API (напоминания): openssl rand -hex 32
INTERNAL_API_KEY=
