# Копия -> .env.prod на сервере (в репозиторий не попадает). Секреты сгенерировать: openssl rand -hex 32
# Домен без https://; для sslip.io — IP через дефисы, например 203-0-113-5.sslip.io
DOMAIN=

POSTGRES_USER=levefit
POSTGRES_PASSWORD=
POSTGRES_DB=levefit

# Токен бота из BotFather
BOT_TOKEN=
APP_SECRET=
INTERNAL_API_KEY=

# ИИ-корректировка; без ключа рекомендации отключены (ответ 503)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

INIT_DATA_MAX_AGE_S=86400
