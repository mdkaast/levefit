{
	# TLS и домен обслуживает общий прокси (infra/proxy); здесь только HTTP внутри сети.
	auto_https off
}

:80 {
	encode zstd gzip

	# Внутренние эндпоинты бота наружу не отдаём (handle идёт раньше общего /api/*).
	handle /api/internal/* {
		respond 404
	}

	handle_path /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
